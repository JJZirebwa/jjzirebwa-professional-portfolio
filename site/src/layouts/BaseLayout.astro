---
import '../styles/global.css';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import headshot from '../assets/images/jubileejoy-zirebwa-headshot.jpg';
import { getSocialCardByPath } from '../data/socialCards';

const {
  title = 'Jubileejoy "JJ" Zirebwa',
  description = 'First Class Biomedical Science graduate with genomics, health data science, healthcare innovation and evidence-led strategy experience.',
  dateModified,
  structuredData = []
} = Astro.props;

const pageTitle = title === 'Jubileejoy "JJ" Zirebwa'
  ? title
  : `${title} | Jubileejoy "JJ" Zirebwa`;

const currentPath = Astro.url.pathname;
const siteUrl = Astro.site ?? new URL('https://jubileejoyzirebwa.com');
const canonicalUrl = new URL(currentPath, siteUrl).href;
const profileImageUrl = new URL(headshot.src, siteUrl).href;
const socialCard = getSocialCardByPath(currentPath);
const socialImageUrl = new URL(`/og/${socialCard.slug}.png`, siteUrl).href;
const includePersonSchema = currentPath === '/about/';
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${canonicalUrl}#profile-page`,
  url: canonicalUrl,
  name: pageTitle,
  ...(dateModified ? { dateModified } : {}),
  mainEntity: {
    '@type': 'Person',
    '@id': `${new URL('/', siteUrl).href}#jubileejoy-zirebwa`,
    name: 'Jubileejoy Zirebwa',
    alternateName: [
      'JJ Zirebwa',
      'Jubileejoy "JJ" Zirebwa',
      'Jubileejoy Zirebwa',
      'Jubilee Joy Zirebwa',
      'Jubilee-Joy Zirebwa',
      'Jubileejoy',
      'Zirebwa'
    ],
    url: new URL('/', siteUrl).href,
    image: profileImageUrl,
    email: 'mailto:jubileejoyzirebwa@gmail.com',
    sameAs: [
      'https://www.linkedin.com/in/jubileejoy-zirebwa',
      'https://github.com/JJZirebwa'
    ],
    knowsAbout: [
      'Biomedical science',
      'Genomics',
      'Healthcare data science',
      'Machine learning',
      'Health innovation strategy',
      'Health innovation',
      'AI and MedTech governance',
      'Biomedical data analysis',
      'Evidence synthesis',
      'Market intelligence'
    ]
  }
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${new URL('/', siteUrl).href}#website`,
  url: new URL('/', siteUrl).href,
  name: 'Jubileejoy "JJ" Zirebwa',
  description,
  publisher: {
    '@type': 'Person',
    '@id': `${new URL('/', siteUrl).href}#jubileejoy-zirebwa`,
    name: 'Jubileejoy Zirebwa'
  }
};
const extraStructuredData = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];
const pageStructuredData = currentPath === '/'
  ? [websiteSchema, ...extraStructuredData]
  : includePersonSchema
  ? [personSchema, ...extraStructuredData]
  : extraStructuredData;
const isActive = (href: string) => href === '/'
  ? currentPath === '/'
  : currentPath.startsWith(href);

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/academic/', label: 'Academic' },
  { href: '/case-studies/', label: 'Experience' },
  { href: '/projects/', label: 'Projects' },
  { href: '/cv/', label: 'CV' },
  { href: '/documents/', label: 'Documents' },
  { href: '/contact/', label: 'Contact' }
];

const footerNavItems = [
  { href: '/now/', label: 'Now' },
  { href: '/academic/', label: 'Academic' },
  { href: '/cv/', label: 'CV' },
  { href: '/documents/', label: 'Documents' },
  { href: '/case-studies/', label: 'Experience' },
  { href: '/projects/', label: 'Projects' },
  { href: '/skills/', label: 'Skills' },
  { href: '/contact/', label: 'Contact' }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#f7f6f1" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content='Jubileejoy "JJ" Zirebwa' />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={socialCard.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialCard.imageAlt} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    {pageStructuredData.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <GoogleAnalytics />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="nav-shell">
        <a class="brand" href="/" aria-label="Home">
          <strong>Jubileejoy "JJ" Zirebwa</strong>
          <span>Biomedical science | Genomics | Health Data</span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={{ 'is-active': isActive(item.href) }}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="footer">
      <div class="footer-shell">
        <div class="footer-copy">
          <strong>Jubileejoy "JJ" Zirebwa</strong>
          <span>Biomedical science, genomics-linked data work and health innovation.</span>
        </div>
        <nav class="footer-nav" aria-label="Footer navigation">
          {footerNavItems.map((item) => <a href={item.href} data-astro-prefetch="hover">{item.label}</a>)}
        </nav>
      </div>
    </footer>
  </body>
</html>
