---
import '../styles/global.css';

const {
  title = 'Jubileejoy "JJ" Zirebwa',
  description = 'Biomedical Science student and early-career healthcare strategy profile.'
} = Astro.props;

const pageTitle = title === 'Jubileejoy "JJ" Zirebwa'
  ? title
  : `${title} | Jubileejoy "JJ" Zirebwa`;

const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === '/'
  ? currentPath === '/'
  : currentPath.startsWith(href);

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/case-studies/', label: 'Case studies' },
  { href: '/projects/', label: 'Projects' },
  { href: '/skills/', label: 'Skills' },
  { href: '/contact/', label: 'Contact' }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#f7f6f1" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="nav-shell">
        <a class="brand" href="/" aria-label="Home">
          <strong>Jubileejoy "JJ" Zirebwa</strong>
          <span>Biomedical science | healthcare strategy | evidence</span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={{ 'is-active': isActive(item.href) }}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="footer">
      <div class="footer-shell">
        <span>Jubileejoy "JJ" Zirebwa</span>
        <span>Selected examples are summarised at a high level to respect confidentiality.</span>
      </div>
    </footer>
  </body>
</html>
