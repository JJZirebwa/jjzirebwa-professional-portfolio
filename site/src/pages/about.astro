---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import logoAru from '../assets/images/logo-aru.png';

const academicRows = [
  ['Degree', 'BSc (Hons) Biomedical Science, Anglia Ruskin University, Cambridge.'],
  ['Status', 'Graduate; First Class Honours awarded on 10 June 2026.'],
  ['Placement year', 'Health Innovation East commercial placement, 2024-2025.'],
  ['Academic classification', 'First Class Honours with final award transcript password protected and available on request.']
];

const themes = [
  'Biomedical science interpreted through clinical context, genetics, data and careful evidence reading.',
  'Genomics-linked health data research with cohort construction, feature reasoning and explicit governance limits.',
  'Healthcare innovation work that connects product claims, evidence quality, pathway fit and stakeholder needs.',
  'AI/MedTech governance literacy across regulation, evidence standards, data protection, interoperability, policy and post-market risk.',
  'Systems-thinking across adoption, incentives and implementation without treating strategy as the whole profile.'
];
---

<BaseLayout
  title="About"
  description="About Jubileejoy Zirebwa, a Biomedical Science graduate with clinical informatics, genomics-linked health data and healthcare innovation experience."
>
  <section class="case-hero">
    <div class="page-shell">
      <p class="eyebrow">Profile</p>
      <h1>About</h1>
      <p class="summary">
        I graduated with First Class Honours in BSc (Hons) Biomedical Science from Anglia Ruskin University in Cambridge, with the award confirmed on 10 June 2026. My work draws together biomedical science, clinical informatics, genomics-linked health data research, a full-year health innovation placement and earlier computational toxicology data work. I use Jubileejoy Zirebwa professionally, but "JJ" works fine too.
      </p>
    </div>
  </section>

  <section class="section-band">
    <div class="page-shell split">
      <div>
        <SectionHeader
          eyebrow="Working direction"
          title="Biomedical science, data and practical judgement"
          lead="I am strongest where scientific information has to be read carefully, structured clearly and carried into a decision without losing the limits of the data."
        />
        <div class="action-row">
          <a class="button secondary" href="/case-studies/final-year-project/">Final-year project</a>
          <a class="button secondary" href="/academic/">Academic profile</a>
          <a class="button secondary" href="/contact/">Get in touch</a>
        </div>
      </div>
      <ul class="compact-list">
        {themes.map((theme) => <li>{theme}</li>)}
      </ul>
    </div>
  </section>

  <section class="section-band light">
    <div class="page-shell">
      <div class="section-with-logo">
        <SectionHeader
          eyebrow="Academic profile"
          title="Biomedical Science"
          lead="The degree is the foundation behind the rest of the portfolio: pathology, genetics, microbiology, pharmacology, translational medicine, quantitative reasoning, data interpretation and scientific writing."
        />
        <div class="institution-mark">
          <Image src={logoAru} alt="Anglia Ruskin University logo" widths={[180, 240]} sizes="(min-width: 901px) 220px, 50vw" />
          <span>Anglia Ruskin University, Cambridge</span>
        </div>
      </div>
      <div class="timeline">
        {academicRows.map(([label, text]) => (
          <div class="timeline-row">
            <strong>{label}</strong>
            <span>{text}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="page-shell grid two">
      <div class="prose">
        <h2>Professional experience</h2>
        <p>
          During my Health Innovation East placement, I worked on NHS-facing innovation questions where evidence, pathway fit and adoption had to be considered together. I built the CB Insights market-intelligence capability and the internal AI Toolkit, and contributed to innovator triage, competitor analysis, QOF-alignment work, business-case support and ICB workstream mapping.
        </p>
      </div>
      <div class="prose">
        <h2>Research and data work</h2>
        <p>
          My final-year project used secure, genomics-linked hospital trajectory data in Brugada-suspect research. I defined the cohort, built ICD and HES-derived features, added observability controls and compared baseline model families. I have since built a public Clinical Informatics project that moves from a synthetic study protocol to linked data, record-level checks, operational metrics and an interactive dashboard.
        </p>
        <p><a href="/projects/clinical-informatics/">Read the Clinical Informatics project</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
