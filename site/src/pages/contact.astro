          <h2>Contact options</h2>
          <ul class="contact-list">
            <li>
              <span>Email</span>
              <a href="mailto:jubileejoyzirebwa@gmail.com">jubileejoyzirebwa@gmail.com</a>
            </li>
            <li>
              <span>Phone</span>
              <a href="tel:+447359454994">+44 7359 454994</a>
            </li>
            <li>
              <span>Location</span>
