---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewTabCue from '../components/NewTabCue.astro';
---

<BaseLayout title="Contact" description="Professional contact details for Jubileejoy Zirebwa in Cambridge, UK.">
  <section class="case-hero">
    <div class="page-shell">
      <p class="eyebrow">Contact</p>
      <h1>Contact</h1>
      <p class="summary">
        I am based in Cambridge, UK, and open to conversations about biomedical science, genomics-linked data, clinical informatics and health innovation.
      </p>
    </div>
  </section>

  <section class="section-band">
    <div class="page-shell">
      <div class="contact-layout">
        <div class="contact-panel">
          <h2>Contact options</h2>
          <ul class="contact-list">
            <li>
              <span>Email</span>
              <a href="mailto:jubileejoyzirebwa@gmail.com">jubileejoyzirebwa@gmail.com</a>
            </li>
            <li>
              <span>Location</span>
              <strong>Cambridge, UK</strong>
            </li>
            <li>
              <span>GitHub</span>
              <a href="https://github.com/JJZirebwa" target="_blank" rel="noreferrer">github.com/JJZirebwa <NewTabCue /></a>
            </li>
            <li>
              <span>LinkedIn</span>
              <a href="https://www.linkedin.com/in/jubileejoy-zirebwa" target="_blank" rel="noreferrer">linkedin.com/in/jubileejoy-zirebwa <NewTabCue /></a>
            </li>
          </ul>
        </div>
      </div>
      <div class="contact-panel contact-panel-secondary">
        <h2>Working approach</h2>
        <p>
          I work best with biomedical science, data and a real decision in view. I am interested in work that involves analysing scientific and commercial information, structuring messy material, building useful technical workflows and explaining what the findings support.
        </p>
        <div class="action-row">
          <a class="button" href="/cv/">View CV</a>
          <a class="button" href="/case-studies/">View experience</a>
          <a class="button secondary" href="/documents/">Documents</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
