---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Contact information and publication boundary for Jubileejoy Zirebwa's professional portfolio.">
  <section class="case-hero">
    <div class="page-shell">
      <p class="eyebrow">Contact</p>
      <h1>Contact</h1>
      <p class="summary">
        For recruitment, application or collaboration conversations, please use the email, LinkedIn profile or application channel through which this portfolio was shared.
      </p>
    </div>
  </section>

  <section class="section-band">
    <div class="page-shell">
      <div class="contact-panel">
        <h2>Professional scope</h2>
        <p>
          I am most interested in work that connects biomedical evidence, healthcare strategy, AI/MedTech governance, market intelligence, evidence synthesis and responsible health-data use.
        </p>
        <div class="action-row">
          <a class="button" href="/case-studies/">View case studies</a>
          <a class="button secondary" href="/skills/">View skills</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
