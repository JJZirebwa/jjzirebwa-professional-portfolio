---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import LinkCard from '../components/LinkCard.astro';
import EditorialPanel from '../components/EditorialPanel.astro';
import { getProjectContextCards, getProjectExploratoryStrand } from '../data/content';

const projectCards = await getProjectContextCards();
const exploratory = await getProjectExploratoryStrand();
---

<BaseLayout title="Projects" description="Project themes across healthcare strategy, biomedical data and exploratory evidence-methods thinking.">
  <section class="case-hero">
    <div class="page-shell">
      <p class="eyebrow">Project themes</p>
      <h1>Projects</h1>
      <p class="summary">
        My project work falls into three connected areas: commercial health innovation, biomedical data and evidence, and careful exploratory thinking about future research methods.
      </p>
    </div>
  </section>

  <section class="section-band light">
    <div class="page-shell">
      <SectionHeader
        eyebrow="Selected projects"
        title="Work with evidence and judgement"
        lead="These project routes show how I approach strategy, data and methods when the evidence is useful but incomplete."
      />
      <div class="grid three">
        {projectCards.map((item) => <LinkCard {...item} meta={item.cardMeta} />)}
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="page-shell">
      <div class="split exploratory-layout">
        <div>
          <SectionHeader
            eyebrow={exploratory.eyebrow}
            title={exploratory.title}
            lead={exploratory.lead}
          />
          <p class="boundary-note">{exploratory.boundary}</p>
        </div>
        <EditorialPanel variant={exploratory.visualVariant} />
      </div>
      <ul class="compact-list exploratory-list">
        {exploratory.items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
