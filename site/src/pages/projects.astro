---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import LinkCard from '../components/LinkCard.astro';
import EditorialPanel from '../components/EditorialPanel.astro';
import { getProjectExploratoryStrand } from '../data/content';

const exploratory = await getProjectExploratoryStrand();

const deliverables = [
  {
    href: '/case-studies/final-year-project/',
    icon: 'data' as const,
    eyebrow: 'Final-year project method',
    title: 'Exploratory modelling approach',
    text: 'Cohort construction, ICD/HES-derived feature engineering, observability controls and LR/RF/NN model comparison under a rare-disease evidence boundary.',
    meta: ['Parent: Final-year project', 'Feature pipeline', 'Model evaluation']
  },
  {
    href: '/case-studies/ai-medtech-toolkit/',
    icon: 'governance' as const,
    eyebrow: 'Health Innovation East deliverable',
    title: 'AI Toolkit',
    text: 'Internal guidance-support material translating AI/MedTech governance, evidence expectations, clinical safety and data requirements into advisory questions.',
    meta: ['Parent: HIE placement', 'AI/MedTech governance', 'Toolkit authoring']
  },
  {
    href: '/case-studies/market-intelligence/',
    icon: 'market' as const,
    eyebrow: 'Health Innovation East method',
    title: 'Market intelligence and competitor analysis',
    text: 'Structured market, competitor and horizon-scanning work for live innovation questions, shaped around evidence quality and pathway fit.',
    meta: ['Parent: HIE placement', 'CB Insights', 'Decision support']
  },
  {
    href: '/case-studies/consoneai-dioscor/',
    icon: 'research' as const,
    eyebrow: 'Internship method',
    title: 'Computational toxicology data preparation',
    text: 'Dose-toxicity data mapping and structured preparation work from the ConsoneAI/DioScor research internship.',
    meta: ['Parent: ConsoneAI/DioScor', 'Data mapping', 'Toxicology context']
  }
];
---

<BaseLayout title="Projects" description="Contained portfolio projects and methods linked to parent experiences.">
  <section class="case-hero">
    <div class="page-shell">
      <p class="eyebrow">Projects</p>
      <h1>Deliverables and methods</h1>
      <p class="summary">
        This page is the contained-work lane. It links focused deliverables and methods back to the larger experiences they came from, so projects do not repeat the parent case studies with different labels.
      </p>
    </div>
  </section>

  <section class="section-band light">
    <div class="page-shell">
      <SectionHeader
        eyebrow="Contained lane"
        title="Focused project work"
        lead="Each card is a deliverable, method or technical workstream. The parent context is named in the card metadata."
      />
      <div class="grid two">
        {deliverables.map((item) => <LinkCard {...item} prefetch="hover" />)}
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="page-shell">
      <div class="split exploratory-layout">
        <div>
          <SectionHeader
            eyebrow={exploratory.eyebrow}
            title={exploratory.title}
            lead={exploratory.lead}
          />
          <p class="boundary-note">{exploratory.boundary}</p>
        </div>
        <EditorialPanel variant={exploratory.visualVariant} />
      </div>
      <ul class="compact-list exploratory-list">
        {exploratory.items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
