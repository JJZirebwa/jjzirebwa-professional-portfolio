---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Icon from '../components/Icon.astro';

const skillGroups = [
  {
    icon: 'strategy',
    skill: 'Healthcare commercial strategy',
    where: 'Health Innovation East placement, QOF/adoption work, PulseOn strategy material and Charco/CUE1 business-case support.',
    produced: 'Evidence summaries, adoption logic, pathway framing, stakeholder decision-driver summaries and value reasoning.',
    matters: 'Good strategy work has to connect clinical need, evidence quality, market context and the realities of adoption.'
  },
  {
    icon: 'evidence',
    skill: 'Evidence synthesis',
    where: 'HIE evidence briefs, market-analysis material, final-year dissertation framing and toxicology data mapping.',
    produced: 'Structured evidence tables, limitations-first summaries, source-to-claim mapping and clear written recommendations.',
    matters: 'Evidence only helps when the strength, limits and relevance of each claim are visible.'
  },
  {
    icon: 'governance',
    skill: 'AI/MedTech governance',
    where: 'AI Toolkit, final-year project governance handling, exploratory methods boundaries and AI-ECG adoption logic.',
    produced: 'Practical guidance-support material, governance framing, claim limits and adoption questions.',
    matters: 'AI health tools need more than technical performance. They need evidence, safety, data governance, interoperability and monitoring.'
  },
  {
    icon: 'market',
    skill: 'Market intelligence and competitor analysis',
    where: 'CB Insights-supported market intelligence, secondary research and competitor-analysis materials across health technologies.',
    produced: 'Structured company lists, trend summaries, competitor matrices and adoption-readiness framing.',
    matters: 'Commercial decisions need a clear view of who else is active, what evidence they have and how mature the space is.'
  },
  {
    icon: 'data',
    skill: 'Biomedical data analysis',
    where: 'Final-year project workflows, dose-toxicity extraction and cleaning, quantitative pharmacology and genetics/statistical reasoning.',
    produced: 'Feature-reasoning summaries, model-evaluation interpretation, cleaned tabular outputs and documented limitations.',
    matters: 'Biomedical data work is strongest when the question, source limits and interpretation rules are clear before analysis begins.'
  },
  {
    icon: 'writing',
    skill: 'Writing and communication',
    where: 'Guidance-support material, public case studies, dissertation writing, module assessments and presentation-style internship outputs.',
    produced: 'Concise summaries, advisory material, case-study narratives, limitations sections and decision-focused tables.',
    matters: 'The work only lands if a reader can see the point, trust the limits and understand what should happen next.'
  }
];
---

<BaseLayout title="Skills" description="Evidence-backed skills across healthcare strategy, evidence synthesis, AI governance, market intelligence, biomedical data and writing.">
  <section class="case-hero">
    <div class="page-shell">
      <p class="eyebrow">Skills map</p>
      <h1>Skills</h1>
      <p class="summary">
        My skills are strongest where scientific evidence has to be made useful for a decision: commercial strategy, adoption logic, governance, data interpretation and clear writing.
      </p>
    </div>
  </section>

  <section class="section-band light">
    <div class="page-shell">
      <SectionHeader
        eyebrow="Evidence-backed"
        title="Core skill areas"
        lead="Each skill below is tied to work I have actually done, the outputs it supported and why it matters in healthcare innovation."
      />
      <div class="grid two">
        {skillGroups.map((group) => (
          <article class="card skill-card">
            <span class="card-icon"><Icon name={group.icon} /></span>
            <span class="tag">Skill</span>
            <h3>{group.skill}</h3>
            <dl>
              <div>
                <dt>Where I used it</dt>
                <dd>{group.where}</dd>
              </div>
              <div>
                <dt>What it supported</dt>
                <dd>{group.produced}</dd>
              </div>
              <div>
                <dt>Why it matters</dt>
                <dd>{group.matters}</dd>
              </div>
            </dl>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
