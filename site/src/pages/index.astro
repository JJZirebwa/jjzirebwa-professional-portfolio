---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import LinkCard from '../components/LinkCard.astro';
import headshot from '../assets/images/jubileejoy-zirebwa-headshot.jpg';
import logoAru from '../assets/images/logo-aru.png';
import logoGenomicsEngland from '../assets/images/logo-genomics-england.png';
import logoHealthInnovationEast from '../assets/images/logo-health-innovation-east.webp';
import { getCaseStudy } from '../data/caseStudies';

const healthInnovationEast = getCaseStudy('health-innovation-east');
const aiToolkit = getCaseStudy('ai-medtech-toolkit');
const marketIntelligence = getCaseStudy('market-intelligence');
const finalYearProject = getCaseStudy('final-year-project');

const startingPoints = [healthInnovationEast, aiToolkit, marketIntelligence, finalYearProject].map((item) => ({
  href: item.href,
  icon: item.icon,
  eyebrow: item.eyebrow,
  title: item.title,
  text: item.text,
  meta: item.cardMeta
}));

const lensSteps = [
  {
    label: 'Signal',
    title: 'Biology and clinical context',
    text: 'Start with the mechanism, patient pathway and the problem a technology claims to solve.'
  },
  {
    label: 'Evidence',
    title: 'Data, claims and uncertainty',
    text: 'Separate what the evidence supports from what still depends on assumptions, validation or better data.'
  },
  {
    label: 'Governance',
    title: 'Safety, regulation and trust',
    text: 'Ask how AI/MedTech, data protection, clinical safety and implementation standards shape responsible adoption.'
  },
  {
    label: 'Adoption',
    title: 'Commercial and policy judgement',
    text: 'Translate evidence into pathway fit, stakeholder value, market readiness and decisions that can be explained clearly.'
  }
];

const contextLogos = [
  {
    src: logoHealthInnovationEast,
    alt: 'Health Innovation East logo',
    label: 'Commercial placement'
  },
  {
    src: logoAru,
    alt: 'Anglia Ruskin University logo',
    label: 'Biomedical Science degree'
  },
  {
    src: logoGenomicsEngland,
    alt: 'Genomics England logo',
    label: 'Secure research context'
  }
];
---

<BaseLayout
  title='Jubileejoy "JJ" Zirebwa'
  description="Biomedical Science, healthcare strategy and evidence-led innovation portfolio for Jubileejoy Zirebwa."
>
  <section class="hero">
    <div class="page-shell hero-grid">
      <div>
        <p class="eyebrow">Professional portfolio</p>
        <h1>Jubileejoy "JJ" Zirebwa</h1>
        <p class="hero-lede">Biomedical science, healthcare strategy and evidence-led innovation.</p>
        <p class="intro-copy">
          I work with biomedical evidence aiming to turn it into real healthcare decisions: testing product claims against evidence quality, pathway fit, governance constraints, stakeholder priorities and what still needs to be proved. My strongest public evidence comes from a full-year Health Innovation East placement across innovation triage, market intelligence, competitor analysis, QOF/ICB-aligned adoption work and an internal AI/MedTech toolkit, alongside governance-first Genomics England TRE research and early computational toxicology data mapping.
        </p>
        <div class="action-row">
          <a class="button" href="/case-studies/">View case studies</a>
          <a class="button secondary" href="/skills/">View skills</a>
          <a class="button secondary" href="/contact/">Contact</a>
        </div>
      </div>
      <div class="hero-visual" aria-label="Portrait and portfolio focus areas">
        <figure class="portrait-card">
          <Image
            src={headshot}
            alt="Jubileejoy Zirebwa"
            widths={[420, 620, 834]}
            sizes="(min-width: 901px) 34vw, 100vw"
            priority
          />
          <figcaption>
            <span>Cambridge, UK</span>
            <strong>Biomedical science with a healthcare strategy lens.</strong>
          </figcaption>
        </figure>
        <div class="evidence-map" aria-label="Portfolio evidence map">
          <div class="map-node">
            <span>Commercial</span>
            <strong>NHS-facing health innovation</strong>
          </div>
          <div class="map-node">
            <span>Governance</span>
            <strong>AI/MedTech governance and adoption</strong>
          </div>
          <div class="map-node">
            <span>Evidence</span>
            <strong>Market, competitor and clinical context</strong>
          </div>
          <div class="map-node">
            <span>Data</span>
            <strong>Secure biomedical research discipline</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="logo-band" aria-label="Selected portfolio contexts">
    <div class="page-shell logo-band-shell">
      <span>Selected contexts</span>
      <div class="logo-row">
        {contextLogos.map((item) => (
          <figure>
            <Image src={item.src} alt={item.alt} widths={[180, 220]} sizes="(min-width: 901px) 18vw, 60vw" />
            <figcaption>{item.label}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section-band light">
    <div class="page-shell">
      <SectionHeader
        eyebrow="Start here"
        title="Best starting points"
        lead="Start here for a clear view of how I work across healthcare strategy, AI governance and biomedical evidence."
      />
      <div class="grid two">
        {startingPoints.map((item) => <LinkCard {...item} />)}
      </div>
    </div>
  </section>

  <section class="section-band lens-band">
    <div class="page-shell profile-lens">
      <div>
        <p class="eyebrow">Working lens</p>
        <h2>From biological signal to adoption decision</h2>
        <p>
          My work sits between biomedical reasoning, health data, AI/MedTech governance and commercial strategy. This is the lens I use when reading a technology, dataset or evidence story.
        </p>
        <div class="gene-thread" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
      <ol class="lens-track">
        {lensSteps.map((step) => (
          <li>
            <span>{step.label}</span>
            <strong>{step.title}</strong>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-band light">
    <div class="page-shell">
      <SectionHeader
        eyebrow="Selected work"
        title="Case studies"
        lead="The case studies focus on the problem, my role, the approach and the judgement involved. They are written for public reading, with sensitive details kept out."
      />
      <div class="grid three">
        <LinkCard
          href={healthInnovationEast.href}
          icon={healthInnovationEast.icon}
          eyebrow={healthInnovationEast.eyebrow}
          title={healthInnovationEast.title}
          text={healthInnovationEast.text}
          meta={healthInnovationEast.cardMeta}
        />
        <LinkCard
          href={aiToolkit.href}
          icon={aiToolkit.icon}
          eyebrow={aiToolkit.eyebrow}
          title={aiToolkit.title}
          text={aiToolkit.text}
          meta={aiToolkit.cardMeta}
        />
        <LinkCard
          href={finalYearProject.href}
          icon={finalYearProject.icon}
          eyebrow={finalYearProject.eyebrow}
          title={finalYearProject.title}
          text={finalYearProject.text}
          meta={finalYearProject.cardMeta}
        />
        <LinkCard
          href="/contact/"
          icon="contact"
          eyebrow="Next step"
          title="Contact and scope"
          text="Role interests, location and the best way to get in touch."
        />
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="page-shell">
      <div class="note">
        <h2>Confidentiality note</h2>
        <p>
          Where appropriate, examples and details are summarised to respect protected information across projects and case studies in my work.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
