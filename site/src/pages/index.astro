---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import LinkCard from '../components/LinkCard.astro';
import headshot from '../assets/images/jubileejoy-zirebwa-headshot.jpg';
import logoAru from '../assets/images/logo-aru.png';
import logoGenomicsEngland from '../assets/images/logo-genomics-england.png';
import logoHealthInnovationEast from '../assets/images/logo-health-innovation-east.webp';
import { getHomeContextRoutes, getHomeFeaturedCaseStudies, type CaseStudyContent } from '../data/content';

interface RouteCard {
  href: string;
  icon: CaseStudyContent['icon'];
  eyebrow: string;
  title: string;
  text: string;
  meta: string[];
}

const featuredCaseStudies = await getHomeFeaturedCaseStudies();
const contextRoutes = await getHomeContextRoutes();

const startingPoints: RouteCard[] = contextRoutes.map((item: CaseStudyContent) => ({
  href: item.href,
  icon: item.icon,
  eyebrow: 'Context',
  title: item.routeContext?.title ?? item.title,
  text: item.routeContext?.description ?? item.summary,
  meta: item.routeContext?.meta ?? item.cardMeta
}));

const contextLogos = [
  {
    src: logoHealthInnovationEast,
    alt: 'Health Innovation East logo',
    label: 'Health innovation placement'
  },
  {
    src: logoAru,
    alt: 'Anglia Ruskin University logo',
    label: 'First Class Biomedical Science'
  },
  {
    src: logoGenomicsEngland,
    alt: 'Genomics England logo',
    label: 'Genomics-linked research'
  }
];
---

<BaseLayout
  title='Jubileejoy "JJ" Zirebwa'
  description="First Class Biomedical Science graduate portfolio spanning genomics, health data science, machine learning, healthcare innovation and evidence-led strategy."
>
  <section class="hero">
    <div class="page-shell hero-grid">
      <div>
        <p class="eyebrow">Professional portfolio</p>
        <h1>Jubileejoy "JJ" Zirebwa</h1>
        <p class="hero-lede">First Class Biomedical Science graduate working across genomics, health data science, machine learning and healthcare innovation.</p>
        <p class="intro-copy">
          My strongest work starts with biomedical evidence and then follows the data, governance and implementation questions that decide whether an analysis or health innovation can be trusted.
        </p>
        <p class="intro-copy">
          This portfolio brings together my First-Class Biomedical Science degree, a dissertation component (awarded 83%) using secure genomics-linked hospital trajectory analysis, a full-year Health Innovation East placement, earlier toxicology data work and selected systems-thinking projects.
        </p>
        <div class="action-row">
          <a class="button" href="/case-studies/final-year-project/">Start with the data project</a>
          <a class="button secondary" href="/academic/">Academic profile</a>
          <a class="button secondary" href="/cv/">View CV</a>
        </div>
      </div>
      <div class="hero-visual" aria-label="Portrait and portfolio focus areas">
        <figure class="portrait-card">
          <Image
            src={headshot}
            alt="Jubileejoy Zirebwa"
            widths={[420, 620, 834]}
            sizes="(min-width: 901px) 34vw, 100vw"
            priority
          />
          <figcaption>
            <span>Cambridge, UK</span>
            <strong>Biomedical science with genomics, data and health innovation evidence.</strong>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="logo-band" aria-label="Selected portfolio contexts">
    <div class="page-shell logo-band-shell">
      <span>Selected contexts</span>
      <div class="logo-row">
        {contextLogos.map((item) => (
          <figure>
            <Image src={item.src} alt={item.alt} widths={[180, 220]} sizes="(min-width: 901px) 18vw, 60vw" />
            <figcaption>{item.label}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section-band light">
    <div class="page-shell">
      <SectionHeader
        eyebrow="Read through my work"
        title="Choose a first route through the work"
        lead="Use the route that matches what you want to check: academic evidence, applied data work, healthcare innovation, current direction or documents."
      />
      <div class="grid two">
        {startingPoints.map((item: RouteCard) => <LinkCard {...item} prefetch="hover" />)}
        <LinkCard
          href="/documents/"
          icon="writing"
          eyebrow="Documents"
          title="CV, transcript and project evidence"
          text="A central place for selected documents, including a general CV, protected transcript and dissertation overview."
          meta={['CV', 'Academic evidence', 'Project overview']}
          prefetch="hover"
        />
        <LinkCard
          href="/now/"
          icon="evidence"
          eyebrow="Current direction"
          title="Now"
          text="A concise snapshot of what I am currently sharpening across biomedical science, genomics-linked data work and health innovation."
          meta={['Current focus', 'Profile direction']}
          prefetch="hover"
        />
      </div>
    </div>
  </section>

  <section class="section-band light">
    <div class="page-shell">
      <SectionHeader
        eyebrow="Selected work"
        title="Experience"
        lead="Parent case studies covering the problem, my role, the method and the judgement involved."
      />
      <div class="grid three">
        {featuredCaseStudies.map((item: CaseStudyContent) => (
          <LinkCard
            href={item.href}
            icon={item.icon}
            eyebrow={item.eyebrow}
            title={item.title}
            text={item.cardText}
            meta={item.cardMeta}
            prefetch="hover"
          />
        ))}
        <LinkCard
          href="/contact/"
          icon="contact"
          eyebrow="Next step"
          title="Contact and scope"
          text="Role interests, location and the best way to get in touch."
          prefetch="hover"
        />
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="page-shell">
      <div class="conversion-panel">
        <div>
          <p class="eyebrow">Call to action</p>
          <h2>Start with the evidence you need</h2>
          <p>
            Start with the <a href="/case-studies/final-year-project/">final-year project</a> for genomics-linked data work, use <a href="/case-studies/health-innovation-east/">Health Innovation East</a> for healthcare innovation experience, or go straight to <a href="/documents/">documents</a> for CV and academic evidence.
          </p>
        </div>
        <div class="action-row">
          <a class="button" href="/case-studies/final-year-project/">Final-year project</a>
          <a class="button secondary" href="/documents/">Documents</a>
          <a class="button secondary" href="/contact/">Get in touch</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="page-shell">
      <div class="note">
        <h2>What is included here</h2>
        <p>
          The site focuses on work that can be explained clearly: academic evidence, technical method, placement deliverables, research judgement and the documents that support them.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
