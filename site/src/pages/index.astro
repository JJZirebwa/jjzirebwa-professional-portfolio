---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import LinkCard from '../components/LinkCard.astro';
import headshot from '../assets/images/jubileejoy-zirebwa-headshot.jpg';
import logoAru from '../assets/images/logo-aru.png';
import logoGenomicsEngland from '../assets/images/logo-genomics-england.png';
import logoHealthInnovationEast from '../assets/images/logo-health-innovation-east.webp';
import { getHomeContextRoutes, getHomeFeaturedCaseStudies, type CaseStudyContent } from '../data/content';

interface RouteCard {
  href: string;
  icon: CaseStudyContent['icon'];
  eyebrow: string;
  title: string;
  text: string;
  meta: string[];
}

const featuredCaseStudies = await getHomeFeaturedCaseStudies();
const contextRoutes = await getHomeContextRoutes();

const startingPoints: RouteCard[] = contextRoutes.map((item: CaseStudyContent) => ({
  href: item.href,
  icon: item.icon,
  eyebrow: 'Context',
  title: item.routeContext?.title ?? item.title,
  text: item.routeContext?.description ?? item.summary,
  meta: item.routeContext?.meta ?? item.cardMeta
}));

const contextLogos = [
  {
    src: logoHealthInnovationEast,
    alt: 'Health Innovation East logo',
    label: 'Health innovation placement',
    href: '/case-studies/health-innovation-east/'
  },
  {
    src: logoAru,
    alt: 'Anglia Ruskin University logo',
    label: 'First Class Biomedical Science',
    href: '/academic/'
  },
  {
    src: logoGenomicsEngland,
    alt: 'Genomics England logo',
    label: 'Genomics-linked research',
    href: '/case-studies/final-year-project/'
  }
];
---

<BaseLayout
  title='Jubileejoy "JJ" Zirebwa'
  description="First Class Biomedical Science graduate portfolio covering practical laboratory training, genomics, health data science, machine learning and healthcare innovation."
>
  <section class="hero">
    <div class="page-shell hero-grid">
      <div>
        <p class="eyebrow">Professional portfolio</p>
        <h1>Jubileejoy "JJ" Zirebwa</h1>
        <p class="hero-lede">First Class Biomedical Science graduate with practical laboratory training and work across genomics, health data science, machine learning and healthcare innovation.</p>
        <p class="intro-copy">
          My strongest work starts with a biomedical question and follows the data, measurement and implementation decisions that determine what the answer can honestly support.
        </p>
        <p class="intro-copy">
          This portfolio brings together the supervised laboratory work completed throughout my degree, a dissertation component awarded 83% using secure genomics-linked hospital trajectory analysis, recent liver MRI and RNA-seq workflows, a public Clinical Informatics project, a full-year Health Innovation East placement and earlier toxicology data work.
        </p>
        <div class="action-row">
          <a class="button" href="/case-studies/final-year-project/">Start with the data project</a>
          <a class="button secondary" href="/academic/#laboratory-practice">Laboratory practice</a>
          <a class="button secondary" href="/cv/">View CV</a>
        </div>
      </div>
      <div class="hero-visual" aria-label="Portrait and portfolio focus areas">
        <figure class="portrait-card">
          <Image
            src={headshot}
            alt="Jubileejoy Zirebwa"
            widths={[420, 620, 834]}
            sizes="(min-width: 901px) 34vw, 100vw"
            priority
          />
          <figcaption>
            <span>Cambridge, UK</span>
            <strong>Biomedical science across practical work, genomics, data and health innovation.</strong>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="logo-band" aria-label="Selected portfolio contexts">
    <div class="page-shell logo-band-shell">
      <span>Selected contexts</span>
      <div class="logo-row">
        {contextLogos.map((item) => (
          <a
            class="context-card-link"
            href={item.href}
            aria-label={item.label}
            data-astro-prefetch="hover"
            data-context-card
          >
            <figure>
              <Image src={item.src} alt={item.alt} widths={[180, 220]} sizes="(min-width: 901px) 18vw, 60vw" />
              <figcaption>{item.label}</figcaption>
            </figure>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-band light">
    <div class="page-shell">
      <SectionHeader
        eyebrow="Read through my work"
        title="Choose a first route through the work"
        lead="Use the route that matches what you want to explore, whether that is laboratory and academic work, applied data, healthcare innovation, current projects or documents."
      />
      <div class="grid two">
        {startingPoints.map((item: RouteCard) => <LinkCard {...item} prefetch="hover" />)}
        <LinkCard
          href="/documents/"
          icon="writing"
          eyebrow="Documents"
          title="CV, transcript and project documents"
          text="A central place for selected documents, including a general CV, protected transcript and dissertation overview."
          meta={['CV', 'Academic record', 'Project overview']}
          prefetch="hover"
        />
        <LinkCard
          href="/now/"
          icon="evidence"
          eyebrow="Current work"
          title="Recent technical work"
          text="Current projects across multiphasic liver MRI, a reproducible RNA-seq service workflow and genomics-linked health data."
          meta={['Liver MRI', 'Nextflow and DESeq2', 'Genomics-linked research']}
          prefetch="hover"
        />
      </div>
    </div>
  </section>

  <section class="section-band light">
    <div class="page-shell">
      <SectionHeader
        eyebrow="Selected work"
        title="Experience"
        lead="Case studies covering the problem, my contribution, the method and the judgement involved."
      />
      <div class="grid three">
        {featuredCaseStudies.map((item: CaseStudyContent) => (
          <LinkCard
            href={item.href}
            icon={item.icon}
            eyebrow={item.eyebrow}
            title={item.title}
            text={item.cardText}
            meta={item.cardMeta}
            prefetch="hover"
          />
        ))}
        <LinkCard
          href="/contact/"
          icon="contact"
          eyebrow="Next step"
          title="Contact"
          text="Location, professional links and the best way to get in touch."
          prefetch="hover"
        />
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="page-shell">
      <div class="conversion-panel">
        <div>
          <p class="eyebrow">Call to action</p>
          <h2>Choose where to start</h2>
          <p>
            Start with <a href="/projects/liver-mri-methods/">Liver MRI Methods</a> for computational imaging, the <a href="/projects/rnaseq-service-workflow/">RNA-seq service workflow</a> for reproducible bioinformatics, the <a href="/case-studies/final-year-project/">final-year project</a> for genomics-linked health data, or <a href="/academic/#laboratory-practice">laboratory practice</a> for degree-based wet-lab and diagnostic work.
          </p>
        </div>
        <div class="action-row">
          <a class="button" href="/academic/#laboratory-practice">Laboratory practice</a>
          <a class="button secondary" href="/documents/">Documents</a>
          <a class="button secondary" href="/contact/">Get in touch</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="page-shell">
      <div class="note">
        <h2>What is included here</h2>
        <p>
          This site brings together my academic record, technical projects, placement work and research decisions, with selected documents available for a closer look.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
