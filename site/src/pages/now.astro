---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import LinkCard from '../components/LinkCard.astro';
---

<BaseLayout
  title="Current work"
  description="Recent computational imaging, bioinformatics and genomics-linked health data work."
>
  <section class="case-hero">
    <div class="page-shell">
      <div>
        <p class="eyebrow">Current work</p>
        <h1>Current work</h1>
        <p class="summary">
          My most recent work has moved through multiphasic MRI, a reproducible RNA-seq service workflow and a final follow-on question from my genomics-linked dissertation. Each project is available here with the method and result that shaped what came next.
        </p>
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="page-shell">
      <SectionHeader
        eyebrow="Most recent"
        title="Recent technical work"
        lead="Three projects with different data, but the same interest in making the analysis inspectable before its conclusions are made ambitious."
      />
      <div class="grid three">
        <LinkCard
          href="/projects/liver-mri-methods/"
          icon="research"
          eyebrow="Computational imaging methods"
          title="Liver MRI Methods"
          text="A multiphasic MRI baseline that treats geometry, registration and visual model review as part of the measurement rather than preparation around it."
          meta={['Multiphasic MRI', 'Registration', 'Model debugging']}
          prefetch="hover"
        />
        <LinkCard
          href="/projects/rnaseq-service-workflow/"
          icon="data"
          eyebrow="Bioinformatics workflow"
          title="Reproducible RNA-seq Service Workflow"
          text="A paired GSE52778 analysis orchestrated with Nextflow from intake checks through DESeq2, result validation and a reusable handover."
          meta={['Nextflow DSL2', 'Paired DESeq2', 'Provenance']}
          prefetch="hover"
        />
        <LinkCard
          href="/case-studies/final-year-project/#mutual-information-continuation"
          icon="data"
          eyebrow="Final-year project continuation"
          title="Testing a second HES representation"
          text="A staged mutual-information and predictive screen that asked whether alternative hospital-code representations recovered useful signal, then stopped when they did not."
          meta={['Mutual information', 'Group-aware testing', 'Stopping rules']}
          prefetch="hover"
        />
      </div>
    </div>
  </section>

  <section class="section-band light">
    <div class="page-shell">
      <SectionHeader
        eyebrow="Related work"
        title="Established projects and experience"
        lead="Earlier work that remains useful context for the current technical projects."
      />
      <div class="grid three">
        <LinkCard
          href="/projects/clinical-informatics/"
          icon="data"
          eyebrow="Self-directed project"
          title="Clinical Informatics"
          text="A synthetic trial-operations demonstration covering protocol mapping, linked data checks, operational metrics and an interactive dashboard."
          meta={['Relational data', 'Operational analysis', 'Live dashboard']}
          prefetch="hover"
        />
        <LinkCard
          href="/case-studies/health-innovation-east/"
          icon="market"
          eyebrow="Health Innovation East"
          title="Healthcare innovation work"
          text="Research and advisory work on evaluation, governance and adoption questions for health technology."
          meta={['Evaluation', 'AI and MedTech', 'Decision support']}
          prefetch="hover"
        />
        <LinkCard
          href="/documents/"
          icon="writing"
          eyebrow="Documents"
          title="CV and selected documents"
          text="Open the general CV, dissertation overview and protected transcript access route."
          meta={['CV', 'Academic record', 'FYP overview']}
          prefetch="hover"
        />
      </div>
    </div>
  </section>
</BaseLayout>
