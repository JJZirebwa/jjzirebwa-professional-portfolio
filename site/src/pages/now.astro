---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import LinkCard from '../components/LinkCard.astro';
import EditorialPanel from '../components/EditorialPanel.astro';
import { getNowUpdates } from '../data/content';

const focusAreas = [
  {
    eyebrow: 'Focus 01',
    title: 'Decision-ready healthcare evidence',
    text: 'Sharpening the work that tests claims against evidence quality, pathway fit, governance constraints and what still has to be proved before a healthcare decision should move.',
    meta: ['Evidence quality', 'Pathway fit', 'Decision support']
  },
  {
    eyebrow: 'Focus 02',
    title: 'Weak-signal biomedical methods',
    text: 'Pushing the final-year project logic further into methods thinking for sparse data, study-design support, measurement prioritisation and disciplined hypothesis generation.',
    meta: ['Weak-signal recovery', 'Method discipline', 'Measurement priorities']
  },
  {
    eyebrow: 'Focus 03',
    title: 'AI/MedTech governance that can actually be used',
    text: 'Continuing the translation work between regulation, evidence standards, clinical safety, information governance and the practical questions that shape adoption conversations.',
    meta: ['Governance translation', 'Clinical safety', 'Adoption questions']
  },
  {
    eyebrow: 'Focus 04',
    title: 'Positioning at the evidence-decision boundary',
    text: 'Building a profile that stays technical enough to read the evidence properly and pragmatic enough to turn that evidence into useful strategic judgement.',
    meta: ['Healthcare strategy', 'Evidence synthesis', 'Biomedical analysis']
  }
];

const sharpeningQuestions = [
  'How do you recover useful signal in sparse biomedical data without pretending the evidence is stronger than it is?',
  'What makes an AI/MedTech evidence story credible enough for real pathway and adoption conversations?',
  'How should commercial health innovation work separate strong proof, plausible promise and unresolved validation gaps?',
  'Which judgement steps can be made more repeatable without flattening the biological, clinical or governance rationale that still matters?'
];

const directionTags = [
  'Healthcare strategy',
  'Health innovation analysis',
  'Evidence synthesis',
  'AI/MedTech governance',
  'Biomedical data and research'
];

const updates = await getNowUpdates();
const lastUpdated = updates[0]?.date ?? new Date('2026-05-15');
const lastUpdatedLabel = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
}).format(lastUpdated);
---

<BaseLayout
  title="Now"
  description="My current focus, active questions and present direction."
>
  <section class="case-hero">
    <div class="page-shell now-hero-grid">
      <div>
        <p class="eyebrow">Current direction</p>
        <h1>Now</h1>
        <p class="summary">
          This page tracks what I am actively sharpening now: where I am moving, what questions I keep returning to and how my strongest evidence connects to the next stage of work.
        </p>
        <p class="status-chip">
          <span>Last updated</span>
          <strong>{lastUpdatedLabel}</strong>
        </p>
      </div>
      <EditorialPanel variant="current-vector" />
    </div>
  </section>

  <section class="section-band">
    <div class="page-shell">
      <SectionHeader
        eyebrow="Present tense"
        title="Current focus"
        lead="Rather than listing everything I could do, this page highlights the strands I am actively deepening because they best connect to my experience and the work I want to keep doing."
      />
      <div class="grid two">
        {focusAreas.map((item) => (
          <article class="card focus-card">
            <span class="tag">{item.eyebrow}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <ul class="card-meta-list" aria-label={`${item.title} focus signals`}>
              {item.meta.map((entry) => <li class="meta-tag">{entry}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-band light">
    <div class="page-shell split">
      <SectionHeader
        eyebrow="Questions"
        title="Questions I am sharpening"
        lead="These are the recurring questions behind my work, because answering solves the tension that is found between scientific evidence, method design and practical healthcare judgement."
      />
      <ul class="compact-list">
        {sharpeningQuestions.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section-band">
    <div class="page-shell split">
      <SectionHeader
        eyebrow="Trajectory"
        title="Direction I am moving toward"
        lead="I am moving toward early-career roles where biomedical evidence has to be interpreted, challenged and translated into strategic, governance-aware or research-grounded action."
      />
      <div class="note">
        <p>
          In practice this means roles concerned with healthcare strategy, health innovation, evidence synthesis, AI/MedTech governance and biomedical data work. The through-line is the kind of problem: messy evidence, real constraints and a decision that still has to be made properly.
        </p>
        <ul class="tag-list">
          {directionTags.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section-band light">
    <div class="page-shell">
      <SectionHeader
        eyebrow="Recent movement"
        title="Recent updates"
        lead="Selective profile and portfolio updates, written for people reading the work and tracking how the public evidence is developing."
      />
      <div class="now-update-list">
        {updates.map((item) => (
          <article class="note now-update-card">
            <p class="update-meta">
              <time datetime={item.date.toISOString()}>{new Intl.DateTimeFormat('en-GB', {
                day: 'numeric',
                month: 'short',
                year: 'numeric'
              }).format(item.date)}</time>
              <span>{item.category}</span>
            </p>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
            {item.href && <a href={item.href}>Open related page</a>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="page-shell">
      <SectionHeader
        eyebrow="Next routes"
        title="Where to go next"
        lead="Use this page to understand my current focus, then return to the strongest evidence and the rest of the site."
      />
      <div class="grid three">
        <LinkCard
          href="/case-studies/health-innovation-east/"
          icon="strategy"
          eyebrow="Strongest evidence"
          title="Health Innovation East"
          text="The clearest route into my NHS-facing commercial innovation, adoption logic and decision-support work."
          meta={['One-year placement', 'Owned deliverables', 'NHS-facing innovation']}
          prefetch="hover"
        />
        <LinkCard
          href="/projects/"
          icon="research"
          eyebrow="Methods and strands"
          title="Projects"
          text="See how the strategy, biomedical data and future-methods strands connect across the wider site."
          meta={['Project routes', 'Exploratory methods', 'Connected evidence']}
          prefetch="hover"
        />
        <LinkCard
          href="/contact/"
          icon="contact"
          eyebrow="Conversation"
          title="Contact"
          text="Use the contact page for role scope, location and the best way to start a conversation."
          meta={['Cambridge, UK', 'Role interests', 'Professional contact']}
          prefetch="hover"
        />
      </div>
    </div>
  </section>
</BaseLayout>
