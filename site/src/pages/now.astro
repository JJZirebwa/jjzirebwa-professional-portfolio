---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import LinkCard from '../components/LinkCard.astro';
---

<BaseLayout
  title="Current work"
  description="Current work and the evidence that supports it."
>
  <section class="case-hero">
    <div class="page-shell">
      <div>
        <p class="eyebrow">Current work</p>
        <h1>Current work</h1>
        <p class="summary">
          I am building on clinical informatics, genomics-linked health data and healthcare innovation work. Each link below leads to the work itself and the evidence behind it.
        </p>
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="page-shell">
      <SectionHeader
        eyebrow="Work in view"
        title="Current evidence"
        lead="The latest self-directed project sits alongside the completed work that informs it."
      />
      <div class="grid three">
        <LinkCard
          href="/projects/clinical-informatics/"
          icon="data"
          eyebrow="Self-directed project"
          title="Clinical Informatics"
          text="A synthetic trial-operations demonstration covering protocol mapping, linked data checks, operational metrics and an interactive dashboard."
          meta={['Relational data', 'Operational analysis', 'Live dashboard']}
          prefetch="hover"
        />
        <LinkCard
          href="/case-studies/final-year-project/"
          icon="data"
          eyebrow="Final-year project"
          title="Genomics-linked health data research"
          text="Rare-disease cohort construction, feature engineering and model comparison with clear observability limits."
          meta={['ICD and HES data', 'Feature pipeline', 'Model evaluation']}
          prefetch="hover"
        />
        <LinkCard
          href="/case-studies/health-innovation-east/"
          icon="market"
          eyebrow="Health Innovation East"
          title="Healthcare innovation evidence"
          text="Research and advisory work on evidence, governance and adoption questions for health technology."
          meta={['Evidence review', 'AI and MedTech', 'Decision support']}
          prefetch="hover"
        />
      </div>
    </div>
  </section>

  <section class="section-band light">
    <div class="page-shell">
      <SectionHeader
        eyebrow="Further detail"
        title="Evidence to explore"
        lead="The case studies and documents give the fuller context, methods and boundaries for this work."
      />
      <div class="grid three">
        <LinkCard
          href="/documents/"
          icon="writing"
          eyebrow="Documents"
          title="CV and documents"
          text="Open the general CV, dissertation overview and protected transcript access route."
          meta={['CV', 'Academic evidence', 'FYP overview']}
          prefetch="hover"
        />
        <LinkCard
          href="/contact/"
          icon="contact"
          eyebrow="Conversation"
          title="Contact"
          text="Get in touch about the work, a role or a potential collaboration."
          meta={['Cambridge, UK', 'Professional contact']}
          prefetch="hover"
        />
      </div>
    </div>
  </section>
</BaseLayout>
