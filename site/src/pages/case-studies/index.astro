---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import LinkCard from '../../components/LinkCard.astro';
import { getCaseStudies, type CaseStudyContent } from '../../data/content';

interface CaseStudyCard {
  href: string;
  icon: CaseStudyContent['icon'];
  eyebrow: string;
  title: string;
  text: string;
  meta: string[];
}

const cases: CaseStudyCard[] = (await getCaseStudies()).map((item: CaseStudyContent) => ({
  href: item.href,
  icon: item.icon,
  eyebrow: item.eyebrow,
  title: item.title,
  text: item.cardText,
  meta: item.cardMeta
}));
---

<BaseLayout title="Case studies" description="Selected healthcare strategy, AI governance and biomedical data case studies.">
  <section class="case-hero">
    <div class="page-shell">
      <p class="eyebrow">Selected work</p>
      <h1>Case studies</h1>
      <p class="summary">
        These case studies summarise selected work across healthcare strategy, AI/MedTech governance, market analysis and biomedical data research. I have focused on the problem, my role, the approach and the judgement involved.
      </p>
    </div>
  </section>

  <section class="section-band light">
    <div class="page-shell">
      <SectionHeader
        eyebrow="Evidence"
        title="Selected case studies"
        lead="Each case study is structured for reading while respecting confidentiality, with fast scan signals for scope, work mode and proof."
      />
      <div class="grid two">
        {cases.map((item: CaseStudyCard) => <LinkCard {...item} prefetch="hover" />)}
      </div>
    </div>
  </section>
</BaseLayout>
