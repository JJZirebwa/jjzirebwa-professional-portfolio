---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import LinkCard from '../../components/LinkCard.astro';
import { getCaseStudies, type CaseStudyContent } from '../../data/content';

interface CaseStudyCard {
  href: string;
  icon: CaseStudyContent['icon'];
  eyebrow: string;
  title: string;
  text: string;
  meta: string[];
}

const allCases = await getCaseStudies();
const toCard = (item: CaseStudyContent): CaseStudyCard => ({
  href: item.href,
  icon: item.icon,
  eyebrow: item.eyebrow,
  title: item.title,
  text: item.cardText,
  meta: item.cardMeta
});

const parentSlugs = ['final-year-project', 'health-innovation-east', 'consoneai-dioscor'];
const childSlugs = ['ai-medtech-toolkit', 'market-intelligence'];
const parentCases: CaseStudyCard[] = allCases
  .filter((item) => parentSlugs.includes(item.slug))
  .map(toCard);
const childCases: CaseStudyCard[] = allCases
  .filter((item) => childSlugs.includes(item.slug))
  .map((item) => ({
    ...toCard(item),
    eyebrow: item.slug === 'ai-medtech-toolkit' ? 'Health Innovation East deliverable' : 'Health Innovation East method'
  }));
---

<BaseLayout title="Experience" description="Case studies across biomedical data, health innovation and biomedical research.">
  <section class="case-hero">
    <div class="page-shell">
      <p class="eyebrow">Experience</p>
      <h1>Case studies</h1>
      <p class="summary">
        Start here for the broader experience pages covering the final-year project, Health Innovation East placement and ConsoneAI/DioScor internship. Focused work is grouped with the experience that gave it context.
      </p>
    </div>
  </section>

  <section class="section-band light">
    <div class="page-shell">
      <SectionHeader
        eyebrow="Experience overview"
        title="Broader experience"
        lead="These pages set out the setting, my contribution, the work delivered and the judgement involved."
      />
      <div class="grid two">
        {parentCases.map((item: CaseStudyCard) => <LinkCard {...item} prefetch="hover" />)}
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="page-shell">
      <SectionHeader
        eyebrow="Focused work"
        title="Deliverables and methods"
        lead="These pages cover focused pieces of work and link back to the experience in which they were developed."
      />
      <div class="grid two">
        {childCases.map((item: CaseStudyCard) => <LinkCard {...item} prefetch="hover" />)}
      </div>
    </div>
  </section>
</BaseLayout>
