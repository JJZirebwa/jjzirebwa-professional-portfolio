---
import CaseStudyPage from '../../components/CaseStudyPage.astro';

const sections = [
  {
    heading: 'Context',
    body: 'My final-year Biomedical Science dissertation used secure, genomics-linked hospital trajectory analysis in a Brugada-suspect context. The work was research-only and not a clinical diagnostic tool.'
  },
  {
    heading: 'My role',
    body: 'I worked within approved secure research arrangements, using temporally bounded hospital episode data before the sequencing index date and maintaining clear boundaries around target definitions, leakage control, reproducibility and limitations.'
  },
  {
    heading: 'Approach',
    items: [
      'Retrospective machine-learning analysis in a secure research environment.',
      'Governance-controlled Brugada-suspect research cohort with temporal indexing.',
      'Grouped ICD/OPCS and utilisation-style feature reasoning.',
      'Comparison of baseline model families, including interpretable and non-linear approaches.',
      'Repeated attention to imbalance, instability, calibration limits and disclosure risk.'
    ]
  },
  {
    heading: 'Outputs / public-safe reconstruction',
    body: 'The public site presents the research design, governance handling, method discipline and limitations. It does not publish raw outputs or disclosure-sensitive material.'
  },
  {
    heading: 'What this shows',
    body: 'This project shows secure health-data research discipline, rare-disease evidence judgement and the ability to report uncertain results without turning them into a clinical success story.'
  }
];
---

<CaseStudyPage
  title="Final-Year Project"
  kicker="Biomedical data and evidence"
  summary="A governance-bound Biomedical Science dissertation using secure, genomics-linked hospital trajectory analysis in a Brugada-suspect research context."
  sections={sections}
  skills={[
    'secure health-data research',
    'rare-disease evidence judgement',
    'feature reasoning',
    'model-evaluation literacy',
    'reproducibility',
    'scientific writing',
    'claim-boundary discipline'
  ]}
  boundary="No raw exports, participant-level data, small counts, model tables, restricted figures, raw ICD/OPCS tables, dissertation extracts or clinical-utility claims are included."
  related={[
    { href: '/about/', label: 'Academic profile' },
    { href: '/projects/', label: 'Biomedical data projects' },
    { href: '/case-studies/ai-medtech-toolkit/', label: 'AI/MedTech governance' }
  ]}
/>
