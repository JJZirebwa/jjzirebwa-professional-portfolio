---
import CaseStudyPage from '../../components/CaseStudyPage.astro';
import logoGenomicsEngland from '../../assets/images/logo-genomics-england.png';
import { getCaseStudy } from '../../data/caseStudies';

const caseStudy = getCaseStudy('final-year-project');

const sections = [
  {
    heading: 'Context',
    body: 'This project trained the discipline of working with uncertain biomedical data: defining cohorts carefully, controlling leakage, comparing model families and reporting limits honestly. The research used secure, genomics-linked hospital trajectory analysis in a Brugada-suspect cohort.'
  },
  {
    heading: 'My role',
    body: 'I worked within approved secure research arrangements, using temporally bounded hospital episode data before the genetic sequencing index date and maintaining clear boundaries around target definitions, leakage control, reproducibility and limitations.'
  },
  {
    heading: 'Approach',
    items: [
      'Retrospective machine-learning analysis in a secure research environment.',
      'Governance-controlled Brugada-suspect research cohort with temporal indexing.',
      'Grouped ICD/OPCS and utilisation-style feature reasoning.',
      'Implementation of logistic regression, random forest and neural networks.',
      'Comparison of baseline model families, including interpretable and non-linear approaches.',
      'Repeated attention to imbalance, instability, calibration limits and disclosure risk.'
    ]
  },
  {
    heading: 'Selected outputs',
    body: 'I describe the research design, governance handling, method discipline and limitations.'
  },
  {
    heading: 'What this shows',
    body: 'The main contribution is not a deployable classifier. It is a biologically and numerically honest account of what hospital trajectories can and cannot reveal in a rare-disease, weak-signal setting. That matters because it shows I can keep model ambition, governance limits, leakage control and claim boundaries aligned rather than forcing a stronger conclusion than the data can support.'
  }
];
---

<CaseStudyPage
  title={caseStudy.title}
  kicker="Biomedical data and evidence"
  summary={caseStudy.summary}
  sections={sections}
  skills={[
    'secure health-data research',
    'rare-disease evidence judgement',
    'machine-learning (logistic regression, random forest, neural networks)',
    'python (SQL, NumPy, Pandas, Scikit-Learn)',
    'feature reasoning',
    'model-evaluation literacy',
    'reproducibility',
    'scientific writing',
    'limitations-led interpretation'
  ]}
  facts={caseStudy.facts}
  contextLogo={{
    src: logoGenomicsEngland,
    alt: 'Genomics England logo',
    label: 'Research context.',
    note: 'Secure, genomics-linked research environment.'
  }}
  boundary="I describe the design and limitations without publishing restricted data, counts or model tables."
  related={[
    { href: '/about/', label: 'Academic profile' },
    { href: '/projects/', label: 'Biomedical data projects' },
    { href: '/case-studies/ai-medtech-toolkit/', label: 'AI/MedTech governance' }
  ]}
/>
