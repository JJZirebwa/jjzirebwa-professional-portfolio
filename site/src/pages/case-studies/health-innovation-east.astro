---
import CaseStudyPage from '../../components/CaseStudyPage.astro';

const sections = [
  {
    heading: 'Context',
    body: 'Health Innovation East gave me a full year inside NHS-facing commercial innovation work. The work was rarely just about whether a technology looked promising. It was about evidence, pathway fit, stakeholder confidence, commercial maturity and the practical route from product claim to adoption decision.'
  },
  {
    heading: 'My role',
    body: 'My role combined independently authored internal work, co-authored work with senior colleagues and support-based contributions across live innovation questions.',
    items: [
      'I authored the internal AI Toolkit.',
      'I drafted QOF strategy material and internal competitor analyses, including major cardisiography analysis.',
      'I independently authored some CB Insights-informed market analyses',
      'I co-authored a strategy advisory document with senior colleagues for a Parkinsons management device.',
      'I supported and co-authored business-case material, including evidence, pathway and value framing for the same innovation.'
    ]
  },
  {
    heading: 'Approach',
    body: 'I learnt to break broad innovation questions into the parts that shape a decision: unmet need, evidence base, competitor landscape, pathway fit, stakeholder confidence, governance risk, data requirements and what evidence would be needed next.'
  },
  {
    heading: 'Selected outputs',
    items: [
      'Evidence briefs and structured evidence summaries.',
      'Competitor comparison packs and technology landscape summaries.',
      'Market and horizon-scanning summaries.',
      'AI/MedTech guidance-support material.',
      'Adoption and value logic notes.',
      'Pathway and stakeholder-decision framing.'
    ]
  },
  {
    heading: 'What this shows',
    body: 'This is the clearest professional evidence of how I think: I can work at the boundary between biomedical evidence, product claims, NHS realities and commercial decision-making without flattening one into the other.'
  }
];
---

<CaseStudyPage
  title="Health Innovation East"
  kicker="Commercial health innovation"
  summary="A one-year commercial placement working across NHS-facing innovation, evidence synthesis, market intelligence, competitor analysis, pathway fit and adoption logic."
  sections={sections}
  skills={[
    'commercial health innovation',
    'evidence synthesis',
    'market intelligence',
    'stakeholder translation',
    'structured writing',
    'responsible judgement',
    'AI/MedTech governance'
  ]}
  contextLogo={{
    src: '/images/logo-health-innovation-east.webp',
    alt: 'Health Innovation East logo',
    label: 'Placement context.',
    note: 'One-year commercial placement, 2024-2025.'
  }}
  boundary="This is a public-facing account of the work and judgement involved. It is not an endorsement by Health Innovation East, NHS bodies or the named companies."
  related={[
    { href: '/case-studies/ai-medtech-toolkit/', label: 'AI Toolkit' },
    { href: '/case-studies/market-intelligence/', label: 'Market intelligence' },
    { href: '/skills/', label: 'Skills' }
  ]}
/>
