---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="Page not found in Jubileejoy Zirebwa's professional portfolio.">
  <section class="case-hero">
    <div class="page-shell">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="summary">
        The page you tried to open is not part of the current portfolio. The main case studies and contact page are the best way back in.
      </p>
      <div class="action-row">
        <a class="button" href="/">Back to home</a>
        <a class="button secondary" href="/case-studies/">View case studies</a>
        <a class="button secondary" href="/contact/">Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>
