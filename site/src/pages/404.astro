---
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkCard from '../components/LinkCard.astro';

const recoveryLinks = [
  {
    href: '/case-studies/health-innovation-east/',
    icon: 'strategy',
    eyebrow: 'Start here',
    title: 'Health Innovation East',
    text: 'Placement evidence across adoption logic, market intelligence and owned deliverables.'
  },
  {
    href: '/case-studies/final-year-project/',
    icon: 'data',
    eyebrow: 'Research',
    title: 'Final-year project',
    text: 'Secure biomedical data work with explicit governance and limitations boundaries.'
  },
  {
    href: '/about/',
    icon: 'academic',
    eyebrow: 'Profile',
    title: 'About my profile',
    text: 'Academic direction, placement context and the wider through-line behind the portfolio.'
  },
  {
    href: '/contact/',
    icon: 'contact',
    eyebrow: 'Contact',
    title: 'Contact and role scope',
    text: 'The quickest route back if you were looking for a specific role fit or context.'
  }
];
---

<BaseLayout title="Page not found" description="Page not found in Jubileejoy Zirebwa's professional portfolio.">
  <section class="case-hero">
    <div class="page-shell">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="summary">
        The page you tried to open is not part of the current portfolio. The experience pages, documents and contact page are the best way back in.
      </p>
      <div class="action-row">
        <a class="button" href="/">Back to home</a>
        <a class="button secondary" href="/case-studies/">View experience</a>
        <a class="button secondary" href="/contact/">Contact</a>
      </div>
    </div>
  </section>

  <section class="section-band light">
    <div class="page-shell">
      <div class="section-header">
        <p class="eyebrow">Recovery</p>
        <h2>Best places to start</h2>
        <p>If you arrived from a CV, LinkedIn or an older saved link, these are the strongest routes back into the current portfolio.</p>
      </div>
      <div class="grid two">
        {recoveryLinks.map((item) => <LinkCard {...item} />)}
      </div>
    </div>
  </section>
</BaseLayout>
