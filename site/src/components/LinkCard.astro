---
import Icon from './Icon.astro';

const { href, eyebrow, title, text, meta = [] } = Astro.props;
---

<a class="card" href={href}>
  {Astro.props.icon && <span class="card-icon"><Icon name={Astro.props.icon} /></span>}
  {eyebrow && <span class="tag">{eyebrow}</span>}
  <h3>{title}</h3>
  <p>{text}</p>
  {meta.length > 0 && (
    <ul class="card-meta-list" aria-label={`${title} proof signals`}>
      {meta.map((item: string) => <li class="meta-tag">{item}</li>)}
    </ul>
  )}
</a>
