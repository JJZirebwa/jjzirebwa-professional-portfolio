---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import EditorialPanel from './EditorialPanel.astro';
import type { EditorialPanelVariant } from '../data/content';

interface CaseSection {
  heading: string;
  body?: string;
  items?: string[];
}

interface RelatedLink {
  href: string;
  label: string;
}

interface CaseFact {
  label: string;
  value: string;
}

interface BreadcrumbItem {
  href?: string;
  label: string;
}

interface ContextLogo {
  src: ImageMetadata;
  alt: string;
  label: string;
  note?: string;
}

interface Props {
  title: string;
  kicker?: string;
  summary: string;
  sections?: CaseSection[];
  skills?: string[];
  facts?: CaseFact[];
  boundary?: string;
  contextLogo?: ContextLogo;
  related?: RelatedLink[];
  visualVariant?: EditorialPanelVariant;
}

const {
  title,
  kicker,
  summary,
  sections = [],
  skills = [],
  facts = [],
  boundary,
  contextLogo,
  related = [],
  visualVariant
} = Astro.props as Props;

const breadcrumbs: BreadcrumbItem[] = [
  { href: '/', label: 'Home' },
  { href: '/case-studies/', label: 'Case studies' },
  { label: title }
];
const siteUrl = Astro.site ?? new URL('https://jubileejoyzirebwa.com');
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: new URL(item.href ?? Astro.url.pathname, siteUrl).href
  }))
};
const slugifySectionHeading = (value: string) =>
  value
    .toLowerCase()
    .trim()
    .replace(/&/g, 'and')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
const sectionsWithIds = sections.map((section, index) => ({
  ...section,
  id: slugifySectionHeading(section.heading) || `section-${index + 1}`
}));
---

<BaseLayout title={title} description={summary} structuredData={breadcrumbSchema}>
  <section class="case-hero">
    <div class="page-shell">
      <Breadcrumbs items={breadcrumbs} />
      {kicker && <p class="eyebrow">{kicker}</p>}
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
    </div>
  </section>

  <div class="page-shell case-layout">
    <aside class="case-sidebar" aria-label="Case study summary">
      {contextLogo && (
        <div class="note logo-note">
          <Image src={contextLogo.src} alt={contextLogo.alt} widths={[240]} sizes="240px" />
          <p><strong>{contextLogo.label}</strong>{contextLogo.note ? ` ${contextLogo.note}` : ''}</p>
        </div>
      )}
      <div class="note">
        <h2>Skills demonstrated</h2>
        <ul class="tag-list">
          {skills.map((skill) => <li>{skill}</li>)}
        </ul>
      </div>
      {boundary && (
        <div class="note">
          <h2>Boundary</h2>
          <p>{boundary}</p>
        </div>
      )}
      {related.length > 0 && (
        <div class="note">
          <h2>Continue with</h2>
          <ul class="compact-list">
            {related.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </div>
      )}
    </aside>

    <div class="case-sections">
      {visualVariant && (
        <section class="case-visual-panel">
          <EditorialPanel variant={visualVariant} />
        </section>
      )}
      {facts.length > 0 && (
        <section class="case-summary-strip" aria-labelledby="case-summary-title">
          <h2 id="case-summary-title">Quick scan</h2>
          <dl class="case-facts">
            {facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}
      {sectionsWithIds.length > 0 && (
        <nav class="case-jump-nav" aria-labelledby="case-jump-title">
          <h2 id="case-jump-title">Jump to</h2>
          <ul>
            {sectionsWithIds.map((section) => (
              <li><a href={`#${section.id}`}>{section.heading}</a></li>
            ))}
          </ul>
        </nav>
      )}
      {sectionsWithIds.map((section) => (
        <section class="case-section" id={section.id}>
          <h2>{section.heading}</h2>
          {section.body && <p>{section.body}</p>}
          {section.items && (
            <ul>
              {section.items.map((item) => <li>{item}</li>)}
            </ul>
          )}
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
