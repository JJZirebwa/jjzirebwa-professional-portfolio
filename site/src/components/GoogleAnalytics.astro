---
const defaultMeasurementId = 'G-FXRKLYT5HY';
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim() || defaultMeasurementId;
const hasMeasurementId = /^G-[A-Z0-9]+$/i.test(measurementId ?? '');
---

{hasMeasurementId && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}></script>
    <script is:inline define:vars={{ measurementId }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag() {
        window.dataLayer.push(arguments);
      };
      window.gtag('js', new Date());
      window.gtag('config', measurementId);
    </script>
  </>
)}
